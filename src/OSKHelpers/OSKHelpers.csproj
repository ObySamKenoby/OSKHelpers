<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFrameworks>netstandard2.0;net8.0</TargetFrameworks>
		<Nullable>disable</Nullable>
		<Platforms>AnyCPU;x86</Platforms>
		<GeneratePackageOnBuild>False</GeneratePackageOnBuild>
		<Title>OSK Helpers</Title>
		<VersionPrefix>2.0.1</VersionPrefix>
		<Authors>Samuele Gaggioli</Authors>
		<Description>General purpose utilities, including Logging and settings (.ini / json) files.</Description>
		<Copyright>OSK Soft di Samuele Gaggioli</Copyright>
	</PropertyGroup>

	<ItemGroup Condition="'$(Configuration)'!='Debug'">
		<Compile Remove="INIFile\Settings.cs" />
		<Compile Remove="Json\Settings.cs" />
	</ItemGroup>

	<ItemGroup>
		<None Include="..\..\docs\images\logo_128px.jpg">
			<Pack>True</Pack>
			<PackagePath>\</PackagePath>
		</None>
		<!-- Include Settings.cs into NuGet package-->
		<None Include="INIFile\Settings.cs">
			<Pack>true</Pack>
			<PackagePath>contentFiles/any/any/.OSKHelpers.content/Settings.cs</PackagePath>
		</None>
		<!-- Include SettingsTemplate.ini into NuGet package-->
		<None Include="INIFile\SettingsTemplate.ini">
			<Pack>true</Pack>
			<PackagePath>contentFiles/any/any/.OSKHelpers.content/SettingsTemplate.ini</PackagePath>
		</None>
		<!-- Include Settings.cs (json) into NuGet package-->
		<None Include="Json\Settings.cs">
			<Pack>true</Pack>
			<PackagePath>contentFiles/any/any/.OSKHelpers.content/Json/Settings.cs</PackagePath>
		</None>
		<None Include="License.txt">
			<Pack>True</Pack>
			<PackagePath>\</PackagePath>
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</None>
		<None Include="ReadMe.md">
			<Pack>True</Pack>
			<PackagePath></PackagePath>
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</None>
	</ItemGroup>

	<PropertyGroup>
		<PackageId>OSKHelpers</PackageId>
		<Company>OSK Soft</Company>
		<PackageIcon>logo_128px.jpg</PackageIcon>
		<PackageReadmeFile>ReadMe.md</PackageReadmeFile>
		<PackageLicenseFile>License.txt</PackageLicenseFile>
		<PackageRequireLicenseAcceptance>True</PackageRequireLicenseAcceptance>
		<PackageOutputPath>C:\TestFolder\NuGet</PackageOutputPath>
		<PackageReleaseNotes>2.0.1 - WebDownloader: optional CancellationToken and inactivity timeout on Download and DownloadAsync; an interrupted download deletes the partial file. Assemblies compiled against 2.0.0 that call WebDownloader must be recompiled.

2.0.0 - Breaking changes, see README for details and migration notes.
- PasswordHash/PasswordHelper: PBKDF2-HMAC-SHA256 with 600,000 iterations, 49-byte versioned hashes and constant-time comparison; 1.x hashes (36 bytes) are still verified and flagged by RequiresRehash.
- Logging: until LogPath is assigned, SimpleLogger, SimpleLog and CSVLogger follow Paths.DefaultLogsDirectory; DEBUG/PROTOCOL labels in DebugWrite/ProtocolWrite lines; ConditionalLog with independent console and file thresholds.
- PropertyStringUtils uses its CultureInfo (default CurrentCulture) instead of the thread culture; an invalid string leaves nullable fields unchanged.
- JsonSettings.Load uses DefaultSerializerOptions; backup names without double dot.
- NetUtils.CheckDNS returns Reachable false for unknown hosts; EmbeddedResourcesUtils throws InvalidOperationException for a missing resource; DaysOfWeekParameter throws ArgumentOutOfRangeException; CSVLogItem writes null values as "".
- OSKIsNumeric returns bool, SimpleLog.ConsoleLog is static, IPAddressExtensionMethods.TryParseMatch(string, out IPAddress) is obsolete.
- Bug fixes in ODBC connection string, GCUtils, Paths, PagingCollection, StringUtils, IniFileHelper and WebDownloader; thread-safe PasswordObfuscator and OSKRandom.Shared.</PackageReleaseNotes>
		<GenerateDocumentationFile>True</GenerateDocumentationFile>
		<PackageProjectUrl>https://github.com/ObySamKenoby/OSKHelpers</PackageProjectUrl>
		<RepositoryUrl>https://github.com/ObySamKenoby/OSKHelpers</RepositoryUrl>
	</PropertyGroup>

	<PropertyGroup Condition="'$(Configuration)'=='Debug'">
		<Version>
			$(VersionPrefix)-pre01
		</Version>
	</PropertyGroup>

	<PropertyGroup Label="Prevents reflection using classes (EmbeddedResourcesUtils) from being removed during package publishing.">
		<EnableTrimAnalyzer>false</EnableTrimAnalyzer>
		<PublishTrimmed>false</PublishTrimmed>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.Win32.Registry" Version="5.0.0" />
		<PackageReference Include="System.Text.Json" Version="8.0.6" />
	</ItemGroup>

	<ItemGroup>
		<Compile Update="Net\NetMessages.Designer.cs">
			<DesignTime>True</DesignTime>
			<AutoGen>True</AutoGen>
			<DependentUpon>NetMessages.resx</DependentUpon>
		</Compile>
	</ItemGroup>

	<ItemGroup>
		<EmbeddedResource Update="Net\NetMessages.resx">
			<Generator>ResXFileCodeGenerator</Generator>
			<LastGenOutput>NetMessages.Designer.cs</LastGenOutput>
		</EmbeddedResource>
	</ItemGroup>

</Project>
